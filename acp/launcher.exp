#!/usr/bin/env expect -f
# Launch a persistent claude --channels session for the ACP session pool.
#
# Parameterized via environment variables (injected by session_pool.ts):
#   HERMES_CHANNEL_SOCKET   Socket path for the hermes-channel plugin to bind.
#                           Propagates to the plugin bun child via parent env
#                           (voie a — proven in spike 2026-06-14: no --strict-mcp-config).
#   HERMES_SESSION_NAME     The --name for the claude process (claude_hermes_<hash8>).
#                           Scoped per session_key — used for targeted kill on eviction.
#   HERMES_SESSION_CWD      Working directory for the claude session.
#   HERMES_CLAUDE_BIN       Path to the claude binary (default: $HOME/.local/bin/claude).
#                           Resolved per instance so each Hermes home uses ITS OWN
#                           claude install — this file is deployed verbatim under
#                           several user accounts.
#   HERMES_CLAUDE_MODEL     Model alias for the claude session (default: haiku).
#                           The model is fixed for the LIFETIME of the process:
#                           claude takes it as a spawn flag, so changing it
#                           requires a respawn, not a live switch. The ACP
#                           supervisor reports this value back to Hermes via
#                           session/set_config_option (see acp_server.ts).
#
# PTY is required so claude can receive the dev-channels TUI confirmation.
# Two blind Enters dismiss the TUI prompt (no-op if not shown).
#
# NEVER use --strict-mcp-config: it suppresses the hermes-channel plugin entirely.

set timeout -1
log_user 1

# Resolve parameters from environment, with safe defaults.
# HERMES_CHANNEL_SOCKET does NOT need to be read here: expect inherits the full
# parent env, and the spawn'd claude process inherits it from expect. The
# hermes-channel plugin bun child then inherits it from claude (voie a, proven
# in spike 2026-06-14). No --strict-mcp-config so the plugin actually starts.
set session_name [expr { [info exists env(HERMES_SESSION_NAME)] ? $env(HERMES_SESSION_NAME) : "claude_hermes_acp" }]
set session_cwd [expr { [info exists env(HERMES_SESSION_CWD)] ? $env(HERMES_SESSION_CWD) : [pwd] }]
# Custom settings file (HERMES_CLAUDE_SETTINGS_FILE, same env var as claude_daemon):
# a controlled allow-list + only the hermes MCP, EXCLUDING the user's private
# plugins/connectors (context7, claude.ai Gmail/Drive/Notes...). Isolates the
# session's toolset from ~/.claude without touching the account/HOME.
set settings_file [expr { [info exists env(HERMES_CLAUDE_SETTINGS_FILE)] ? $env(HERMES_CLAUDE_SETTINGS_FILE) : "" }]
# Default = lean tool set (janet_test unchanged). Prod overrides via
# HERMES_CLAUDE_ALLOWED_TOOLS to include its full plugin set (space-separated,
# passed as a single string — same shape as the hardcoded default below).
set allowed_tools [expr { [info exists env(HERMES_CLAUDE_ALLOWED_TOOLS)] && $env(HERMES_CLAUDE_ALLOWED_TOOLS) ne "" ? $env(HERMES_CLAUDE_ALLOWED_TOOLS) : "mcp__plugin_hermes-channel_hermes-channel__* Read" }]
# Model alias (haiku | sonnet | default). Default "haiku" keeps every existing
# instance byte-identical to the hardcoded behaviour this replaced. Whoever sets
# this must also align Hermes' own `model.default` in config.yaml: the supervisor
# answers session/set_config_option with the value in force HERE, and the Hermes
# client raises when the two disagree (deliberate — a silent mismatch used to
# mean paying for a model nobody chose).
set claude_model [expr { [info exists env(HERMES_CLAUDE_MODEL)] && $env(HERMES_CLAUDE_MODEL) ne "" ? $env(HERMES_CLAUDE_MODEL) : "haiku" }]
# Claude binary. This file is deployed verbatim into several Hermes homes owned
# by DIFFERENT user accounts, so an absolute path here makes one instance depend
# on another user's install — Bad Janet (gduquesnay) was running guillaume's
# binary. Resolve per instance from HOME instead; the supervisors do export it
# (verified live: HOME=/Users/gduquesnay for Bad Janet's pool).
# The literal fallback only covers a HOME-less environment, which the pool never
# produces — it exists so a hand-run launcher degrades to the historical path
# rather than spawning "/.local/bin/claude".
set claude_bin [expr { [info exists env(HERMES_CLAUDE_BIN)] && $env(HERMES_CLAUDE_BIN) ne "" ? $env(HERMES_CLAUDE_BIN) : ([info exists env(HOME)] && $env(HOME) ne "" ? "$env(HOME)/.local/bin/claude" : "/Users/guillaume/.local/bin/claude") }]

# Reply-delivery protocol, appended to every session's system prompt.
#
# The hermes-channel plugin ships the same text as its MCP server instructions,
# but Claude Code does not always hand them to the model: on 2026-10-14 (claude
# 2.1.299) a session received the first <channel> message with no
# mcp_instructions_delta at all, answered in plain text, never called
# reply_close, and the user got nothing (no Janet reply since 2026-07-27). The
# zeta launcher avoids this by carrying its reply rule in its own launch; so
# does this one.
#
# This is the DELIVERY MECHANISM only, never persona: identity stays in
# SOUL.md / the sandbox CLAUDE.md (see CONFIGURATION.md).
#
# Must stay byte-identical to the `instructions` array in
# marketplace/external_plugins/hermes-channel/server.ts. acp/src/
# launcher_reply_protocol.test.ts runs this launcher against a stub claude and
# fails on any difference. Brace-quoted so Tcl does no substitution; the text
# must therefore hold no braces or backslashes, and no "confirm" (the TUI loop
# below matches that word in the spawn echo, which now includes this text).
set reply_protocol [string trim {
MANDATORY: your text/transcript output is NEVER delivered to the user — it is silently discarded. The ONLY way to send a response is calling the reply_close tool. If your turn ends without calling reply_close, the user receives absolutely nothing and your work is lost.

This overrides anything your persona or identity instructions say about answering "directly" or "immediately" or being concise — those describe your TONE, not your delivery mechanism. Answering directly means calling reply_close with your direct answer, not skipping the call.

Inbound prompts arrive as <channel source="hermes" chat_id="..." user="hermes" ts="...">. The chat_id IS the request_id.

Protocol — decide immediately which of these two cases you are in:

CASE A — you can answer without any other tool (this is most turns): your VERY FIRST tool call MUST be reply_close(chat_id, text), with your COMPLETE final answer as text. Do not write your answer as plain text/reasoning first, and do not call any other tool first — compose the whole reply directly inside reply_close's text argument and call it immediately, as your first action this turn. There is no benefit to thinking out loud before it: that output is discarded anyway, and delaying reply_close is the only way this case can go wrong.

CASE B — you genuinely need another tool (Read, Bash, Agent, etc.) to produce the answer: use those tools as needed, then call reply_close(chat_id, text) with your complete final response as your LAST tool call.

MANDATORY: if you launch background/async work (Agent tool, background Bash) and are about to return control while that work keeps running, you MUST still call reply_close before the end of your turn — deliver an interim answer (e.g. "I started X, I will follow up") and report the async results later in a NEW turn when the notification arrives. This is a CASE B turn: the Agent/Bash call is the other tool, reply_close still comes last.
NEVER leave a turn open waiting for async work: the turn times out and the user receives an empty response.

Advanced (optional): call reply_open(chat_id) first if you want to send progress updates via reply_chunk(handle, text) before the final reply_close(handle, text). Only needed for that case — skip it for the common cases above.

Before you finish this turn, double check: did you call reply_close? If not, do it now — a plain text reply is never seen by anyone. Only reply_close delivers the result.
}]

cd $session_cwd

if {$settings_file ne ""} {
    spawn $claude_bin \
        --dangerously-load-development-channels plugin:hermes-channel@claude-channels-hermes \
        --name $session_name \
        --permission-mode dontAsk \
        --model $claude_model \
        --setting-sources project,local \
        --settings $settings_file \
        --append-system-prompt $reply_protocol \
        --allowedTools $allowed_tools
} else {
    spawn $claude_bin \
        --dangerously-load-development-channels plugin:hermes-channel@claude-channels-hermes \
        --name $session_name \
        --permission-mode dontAsk \
        --model $claude_model \
        --append-system-prompt $reply_protocol \
        --allowedTools $allowed_tools
}

# Dismiss sequential TUI prompts (dev-channels confirmation, folder-trust, ...)
# by matching the single word "confirm" — the ONLY reliable anchor.
#
# Hard-won findings (badjanet bringup 2026-07-04, see zeta session notes):
# - The raw pty stream interleaves ANSI codes inside sentences
#   (\e[1mEnter\e[22m to confirm), so multi-word patterns like
#   "Enter to confirm" NEVER match on slow boots.
# - The historical pattern {development|confirm|...} matched the spawn
#   command ECHO (--dangerously-load-DEVELOPMENT-channels) and fired the
#   Enters before the TUI existed; the TUI purges buffered input on draw.
#   It only worked when claude booted to the prompt in <1s.
# - Blind timed sends fail too: boot-to-prompt varies 1-45s with host load.
# The spawn echo contains "development" but never "confirm", so a bare
# {confirm} match is safe and fires exactly when a prompt is on screen. That
# holds for $reply_protocol too, which is part of the echo: keep it free of the
# word (launcher_reply_protocol.test.ts fails if it is not).
set timeout 45
for {set i 0} {$i < 3} {incr i} {
    expect {
        -re {confirm} {
            sleep 1
            send "\r"
            set timeout 20
        }
        timeout { break }
        eof { exit 0 }
    }
}
set timeout -1

expect eof
